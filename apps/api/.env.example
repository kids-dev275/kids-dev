# Server Configuration
NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# Database Configuration (Supabase PostgreSQL)
# Pooled/runtime connection
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"
# Direct connection for migrations
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Frontend Application URL (for CORS)
FRONTEND_URL="http://localhost:3000"

# Session & Security
SESSION_SECRET="development-session-secret-change-in-production-min-32-chars"
ADMIN_SESSION_COOKIE_NAME="kw_admin_session"
ADMIN_SESSION_TTL_HOURS=168
CUSTOMER_SESSION_COOKIE_NAME="kw_customer_session"
CUSTOMER_SESSION_TTL_HOURS=720
COOKIE_SAME_SITE="lax"
COOKIE_SECURE=false

# Admin Provisioning (Development/Operations only — do not set permanent passwords here)
# ADMIN_EMAIL="sk.fabrica@gmail.com"
# ADMIN_PASSWORD="temporary-development-only-password"

# Media Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Transactional Email (Resend)
# Production deployment requires configuring an active API key and a verified sender identity.
RESEND_API_KEY="re_your_api_key_here"
RESEND_FROM_EMAIL="Kids Wear <verified-sender@yourdomain.com>"
