{
  "name": "kids-wear",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter web --filter api --parallel dev",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build": "pnpm --filter @kids-wear/shared build && pnpm --filter api build && pnpm --filter web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter api db:generate",
    "db:validate": "pnpm --filter api db:validate",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:migrate:deploy": "pnpm --filter api db:migrate:deploy",
    "db:seed": "pnpm --filter api db:seed",
    "db:smoke": "pnpm --filter api db:smoke",
    "admin:provision": "pnpm --filter api admin:provision",
    "test:admin-auth": "pnpm --filter api test:admin-auth",
    "test:customer-auth": "pnpm --filter api test:customer-auth",
    "test:storefront-settings": "pnpm --filter api test:storefront-settings",
    "test:product-core": "pnpm --filter api test:product-core",
    "test:product-options-variants": "pnpm --filter api test:product-options-variants",
    "test:product-media": "pnpm --filter api test:product-media",
    "test:product-publication-catalog": "pnpm --filter api test:product-publication-catalog",
    "test:size-guide": "pnpm --filter api test:size-guide",
    "test:design-system": "pnpm --filter web test:design-system",
    "test:storefront-shell": "pnpm --filter web test:storefront-shell",
    "test:storefront-catalog": "pnpm --filter web test:storefront-catalog",
    "test:cart": "pnpm --filter web test:cart",
    "test:checkout": "pnpm --filter web test:checkout",
    "test:order-creation": "pnpm --filter web test:order-creation",
    "test:cart-validation": "pnpm --filter api test:cart-validation",
    "test:checkout-validation": "pnpm --filter api test:checkout-validation",
    "test:order-creation-api": "pnpm --filter api test:order-creation-api",
    "test:customer-orders": "pnpm --filter api test:customer-orders",
    "test:admin-orders": "pnpm --filter api test:admin-orders",
    "test:account": "pnpm --filter web test:account",
    "test:reviews": "pnpm --filter web test:reviews",
    "test:reviews-api": "pnpm --filter api test:reviews-api",
    "test:admin-dashboard": "pnpm --filter api test:admin-dashboard",
    "test:admin-ui": "pnpm --filter web test:admin-ui",
    "test:content-pages": "pnpm --filter web test:content-pages",
    "test:security": "pnpm --filter api test:security",
    "test:performance": "pnpm --filter api test:performance",
    "test:accessibility": "pnpm --filter web test:accessibility",
    "test:accessibility:axe": "playwright test --config=playwright.axe.config.ts",
    "test:seo": "pnpm --filter web test:seo",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:staging": "pnpm --filter api tsx ../../scripts/staging-smoke.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "prettier": "^3.5.2",
    "typescript": "^5.7.3"
  }
}
